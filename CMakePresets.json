{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "base",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/artifacts",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "DEV_BRANCH": false,
                "NEW_DYNAREC": true,
                "QT": true
            },
            "generator": "Ninja",
            "hidden": true
        },
        {
            "name": "regular",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEW_DYNAREC": "ON"
            },
            "inherits": "base"
        },
        {
            "name": "optimized",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Optimized"
            },
            "inherits": "base"
        },
        {
            "name": "debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NV_LOG": "ON"
            },
            "inherits": "base"
        },
        {
            "name": "development",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "DEV_BRANCH": true
            },
            "inherits": "base"
        },
        {
            "name": "dev_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DEV_BRANCH": true
            },
            "inherits": "base"
        },
        {
            "name": "ultra_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "UltraDebug",
                "DEV_BRANCH": true
            },
            "inherits": "base"
        }
    ],
    "buildPresets": [],
    "testPresets": []
}
